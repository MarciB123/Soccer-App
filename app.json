{
  "expo": {
    "name": "Soccer AI Coach",
    "slug": "soccer-ai-coach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "socceraicoach",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14532D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.socceraicoach.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to record training videos for AI analysis.",
        "NSPhotoLibraryUsageDescription": "Used to select training videos for AI analysis.",
        "NSMicrophoneUsageDescription": "Used to record audio during training sessions.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.socceraicoach.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#14532D"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#16A34A",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14532D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b9f4e60-d8a7-40f4-abfe-8a5b0126b107"
      }
    }
  }
}
